{
  "logging": {
    "level": "info"
  },
  "targets": {
    "loginUrl": "https://sep.ucas.ac.cn/?loginFrom=/appStore",
    "lectureUrl": "https://xkcts.ucas.ac.cn:8443/subject/humanityLecture"
  },
  "runtime": {
    "mode": "single",
    "headless": true,
    "dryRun": true,
    "statePath": ".cache/lecture-state.json",
    "schedule": {
      "periods": [
        ["08:00", "18:00"]
      ],
      "intervalMinutes": 60,
      "runImmediatelyOnStart": true
    }
  },
  "captcha": {
    "enabled": true,
    "maxAttempts": 3,
    "pythonExecutable": ".venv-ddddocr/bin/python"
  },
  "filter": {
    "timeWindows": [
      {
        "weekday": 1,
        "periods": [["17:00", "23:59"]]
      },
      {
        "weekday": 2,
        "periods": [["19:00", "23:59"]]
      },
      {
        "weekday": 3,
        "periods": [["00:00", "23:59"]]
      }
    ]
  }
}
